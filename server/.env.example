# Copy this file to ".env" and fill in real values. Never commit ".env".
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string. Replace the placeholders with your own Atlas user,
# password and cluster host. Leave it blank to run without a database (auth routes return 503).
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/smart-visitor-management?retryWrites=true&w=majority

# REQUIRED. Secret used to sign login tokens: at least 32 random characters.
# The server refuses to start while this is empty or still "change-me".
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# bcrypt cost factor (optional, default 12)
# BCRYPT_ROUNDS=12

# Only for the one-time "npm run create-admin" command. Fill in, run it, then DELETE the password line.
# ADMIN_NAME=Your Name
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=choose-a-strong-password-of-10-plus-chars

# Brevo (https://www.brevo.com) sends the temporary-password email when an admin adds a person.
# Leave BREVO_API_KEY blank in development: the temp password is then printed in the server console.
# BREVO_SENDER_EMAIL must be a sender you have verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Smart Visitor Management
